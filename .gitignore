# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Environments
.env
.venv
env/
venv/
ENV/

# FedIEC Local Data & Symlinks
/data/
data/
!data/.gitkeep

# Raw & processed dataset files
*.pcap
*.pcapng
*.cap
*.tar.gz
*.tgz
*.7z
*.zip
*.parquet
*.npz

# Temporary downloads, partial & ongoing transfer artifacts
*.aria2
*.part
*.ongoing
*.tmp
*.temp
*.crdownload
*INCOMPLETE*

# Download-state, session, & progress artifacts
download_state*.json
download_manifest*.json
*.download_manifest.json
DOWNLOAD_STATUS*.md
*cookies*.txt
*.session
*.log

# Python virtual environments / packaging
.venv/
*.egg-info/
build/
dist/

# Tool caches
.ruff_cache/
.pytest_cache/
.mypy_cache/
.pyright/
.hypothesis/
.coverage
htmlcov/

# Graphify temporary/generated output (never committed by default)
graphify-out/

# Reproducible workspace — regenerable from raw data + config + code
outputs/
!outputs/.gitkeep

# OS/editor
.DS_Store
*.swp
